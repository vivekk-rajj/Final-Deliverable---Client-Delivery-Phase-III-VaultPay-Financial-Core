* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #f3f6fb;
  color: #172133;
}

button,
input,
select {
  font: inherit;
}

button {
  cursor: pointer;
}

.auth-shell,
.forbidden-page {
  min-height: 100vh;
  display: grid;
  place-items: center;
  padding: 24px;
}

.auth-card,
.forbidden-card,
.panel {
  background: #fff;
  border-radius: 16px;
  box-shadow: 0 12px 30px rgba(23, 33, 51, 0.08);
}

.auth-card {
  width: min(100%, 460px);
  padding: 32px;
}

.brand-row {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 12px;
}

.logo-mark {
  width: 44px;
  height: 44px;
  border-radius: 12px;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, #0d3b66, #1c7bd9);
  color: white;
  font-weight: bold;
  font-size: 1.4rem;
}

.eyebrow {
  color: #58779a;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  font-size: 0.7rem;
  font-weight: 700;
}

h1, h2, p {
  margin-top: 0;
}

label {
  display: block;
  margin-bottom: 16px;
  color: #324154;
  font-weight: 600;
}

input,
select {
  width: 100%;
  margin-top: 8px;
  padding: 12px 14px;
  border: 1px solid #cfdaf0;
  border-radius: 10px;
  background: #f9fbff;
}

button {
  width: 100%;
  padding: 12px 16px;
  border: none;
  border-radius: 10px;
  background: linear-gradient(135deg, #0d3b66, #1c7bd9);
  color: white;
  font-weight: 700;
}

button:disabled {
  opacity: 0.7;
  cursor: not-allowed;
}

button.ghost {
  background: #eef3fb;
  color: #10233d;
  width: auto;
}

.page-header {
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32px 24px 12px;
}

.dashboard-shell {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 24px 40px;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 18px;
  margin-bottom: 28px;
}

.stat-card {
  background: linear-gradient(135deg, #112d4a, #2f6fc0);
  color: white;
  border-radius: 16px;
  padding: 20px;
}

.stat-card span {
  display: block;
  opacity: 0.8;
  margin-bottom: 8px;
}

.stat-card strong {
  font-size: 2rem;
}

.panel {
  padding: 24px;
  margin-bottom: 24px;
}

.grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}

.invoice-list {
  display: grid;
  gap: 16px;
}

.invoice-card {
  display: flex;
  justify-content: space-between;
  gap: 18px;
  border: 1px solid #e8edf7;
  border-left: 5px solid #c7d8f6;
  border-radius: 12px;
  padding: 18px;
  background: #fbfcff;
}

.invoice-card.unpaid {
  border-left-color: #f0b04f;
}

.invoice-card.paid {
  border-left-color: #4bbf8d;
}

.invoice-card.pending {
  border-left-color: #d7ad1d;
}

.invoice-number {
  font-weight: 700;
  margin-bottom: 6px;
}

.action-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10px;
  margin-top: 12px;
}

.action-row a,
.primary-link {
  color: #1b4d8d;
  font-weight: 700;
  text-decoration: none;
}

.pay-btn {
  width: auto;
}

.paid-pill {
  display: inline-block;
  padding: 6px 10px;
  border-radius: 999px;
  background: #daf7ea;
  color: #0e7d52;
  font-weight: 700;
}

.error {
  color: #b42318;
  margin-top: 16px;
}

.demo-block {
  margin-top: 24px;
  background: #f5f8ff;
  border-radius: 12px;
  padding: 12px 14px;
  color: #20324f;
}

.forbidden-card {
  width: min(100%, 420px);
  padding: 32px 28px;
  text-align: center;
}

@media (max-width: 720px) {
  .grid-2,
  .invoice-card {
    grid-template-columns: 1fr;
    display: grid;
  }
}
